# Server Configuration
SERVER_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=secret123
DB_NAME=goauthdb
DB_URL=postgres://admin:secret123@localhost:5432/goauthdb?sslmode=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
# IMPORTANT: Generate a strong, random secret key for production!
# You can generate one using: openssl rand -base64 64
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-characters
JWT_BCRYPT_COST=4  # 4 = ~100ms (dev), 10 = ~3s (production)

# Email Configuration (SMTP)
# For Gmail: Use App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Go Auth Service

# Application Configuration
APP_URL=http://localhost:8080

# Application Environment
APP_ENV=development



