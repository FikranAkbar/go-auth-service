meta {
  name: Register User
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "fikranakbar756@gmail.com",
    "username": "fikranakbar",
    "password": "securePassword123"
  }
}

tests {
  test("should return 201 status", function() {
    expect(res.status).to.equal(201);
  });
  
  test("should return success status", function() {
    expect(res.body.status).to.equal('success');
  });
  
  test("should return verification message", function() {
    expect(res.body.data.message).to.include('verification');
    expect(res.body.data.email).to.equal('test@example.com');
  });
  
  test("should return verification token (temporary - will be sent via email)", function() {
    expect(res.body.data.verification_token).to.be.a('string');
  });
  
  test("should NOT return access/refresh tokens yet", function() {
    expect(res.body.data.access_token).to.be.undefined;
    expect(res.body.data.refresh_token).to.be.undefined;
  });
}
